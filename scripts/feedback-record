#!/bin/sh
# Launch the typed Python `feedback-record` writer.
#
# The historical entry point path is preserved for in-repo tests and callers;
# installed skills use the `feedback-record` console script declared in
# pyproject.toml.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$here/.venv/bin/python" ]; then
  python=$here/.venv/bin/python
else
  python=${PYTHON:-python3}
fi
PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$python" -m braintree.feedback_record "$@"
